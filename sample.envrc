# nix-direnv refreshes gcroot mtimes with `touch flake-profile-*`, whose glob
# also matches the watched flake-profile-*.rc cache file. Touching the cache
# file makes every other shell in this directory reload, so restrict the touch
# to the gcroot symlinks.
_nix_refresh_gcroots() {
    local layout_dir f
    layout_dir=$(direnv_layout_dir)
    for f in "${layout_dir}"/flake-profile* "${layout_dir}"/flake-inputs/* "${layout_dir}"/nix-profile*; do
        [[ -L $f ]] || continue
        touch -h "$f"
    done
}

use flake ./nix

bitwarden_org=d76a483e-3e70-450d-b7d0-b3a9015fa410
repo=throwparty/agentkit
creds="$(bw get item --organizationid "$bitwarden_org" "$repo")"
get_cred_field_value() {
    local field="$1"
    local selector
    selector="$(printf '.fields[] | select(.name == "%s") | .value' "$field")"
    jq --raw-output "$selector" <<<"$creds"
}

export LENS_BRAVE_SEARCH_API_KEY
LENS_BRAVE_SEARCH_API_KEY="$(get_cred_field_value "lens Brave Search")"
export LENS_KAGI_SEARCH_API_KEY
LENS_KAGI_SEARCH_API_KEY="$(get_cred_field_value "lens Kagi Search")"

export SWITCHBOARD_OPENAI_API_KEY
SWITCHBOARD_OPENAI_API_KEY="$(get_cred_field_value "switchboard OpenAI")"
