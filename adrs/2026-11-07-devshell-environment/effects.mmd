flowchart TB
    cfg["[[provision]]<br/>identity, kind, settings"] --> res["resolver<br/>validates identity, kind and order"]
    res --> seq["ordered steps"]
    seq -->|command| req["request"]
    seq -->|devshell| host["host step<br/>runs nix before the sandbox exists"]
    host --> eff1["environment<br/>names and values, with provenance"]
    host --> eff2["read-only grants<br/>one per store path"]
    host --> eff3["written file<br/>bash functions"]
    eff1 --> req
    eff2 --> req
    eff3 --> req
    req --> backend["backend<br/>applies what it can honour, refuses the rest"]
    backend --> bw["bubblewrap"]
    backend --> sb["Seatbelt"]
    backend --> dk["Docker"]
