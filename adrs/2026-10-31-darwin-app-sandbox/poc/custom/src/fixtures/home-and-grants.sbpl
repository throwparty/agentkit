(version 1)

(deny default
  (with message "litterbox"))

(allow process-exec)
(allow process-fork)
(allow process-info*
  (target same-sandbox))
(allow signal
  (target same-sandbox))
(allow file-read*
  (literal "/")
  (subpath "/usr/bin")
  (subpath "/usr/lib")
  (subpath "/usr/share")
  (subpath "/usr/libexec")
  (subpath "/System/Library")
  (subpath "/System/Applications")
  (subpath "/Library/Developer")
  (subpath "/Applications/Xcode.app/Contents/Developer")
  (subpath "/Library/Frameworks")
  (subpath "/bin")
  (subpath "/sbin")
  (subpath "/private/etc")
  (subpath "/private/var/db/dyld")
  (subpath "/private/var/select")
  (subpath "/dev")
  (subpath "/nix/store"))
(allow sysctl-read)
(allow mach-lookup
  (global-name "com.apple.system.logger")
  (global-name "com.apple.system.notification_center")
  (global-name "com.apple.distributed_notifications@Uv3")
  (global-name "com.apple.logd")
  (global-name "com.apple.lsd.mapdb")
  (global-name "com.apple.fonts")
  (global-name "com.apple.FontObjectsServer")
  (global-name "com.apple.PowerManagement.control")
  (global-name "com.apple.system.opendirectoryd.libinfo")
  (global-name "com.apple.system.opendirectoryd.membership")
  (global-name "com.apple.bsd.dirhelper")
  (global-name "com.apple.SystemConfiguration.configd"))

(allow file-read-metadata
  (literal "/")
  (subpath "/usr/bin")
  (subpath "/usr/lib")
  (subpath "/usr/share")
  (subpath "/usr/libexec")
  (subpath "/System/Library")
  (subpath "/System/Applications")
  (subpath "/Library/Developer")
  (subpath "/Applications/Xcode.app/Contents/Developer")
  (subpath "/Library/Frameworks")
  (subpath "/bin")
  (subpath "/sbin")
  (subpath "/private/etc")
  (subpath "/private/var/db/dyld")
  (subpath "/private/var/select")
  (subpath "/dev")
  (subpath "/nix/store")
  (subpath "/private/tmp/lbx-golden/ws")
  (subpath "/private/tmp/lbx-golden/read")
  (subpath "/private/tmp/lbx-golden/write")
  (literal "/private")
  (literal "/private/tmp")
  (literal "/private/tmp/lbx-golden"))

(allow file-read*
  (literal "/")
  (subpath "/private/tmp/lbx-golden/read")
  (subpath "/private/tmp/lbx-golden/ws")
  (subpath "/private/tmp/lbx-golden/write"))

(allow file-write*
  (literal "/dev/null")
  (subpath "/private/tmp/lbx-golden/ws")
  (subpath "/private/tmp/lbx-golden/write"))

(deny file-read*
  (subpath "/private/tmp/lbx-golden/home/.ssh")
  (subpath "/private/tmp/lbx-golden/home/.aws")
  (subpath "/private/tmp/lbx-golden/home/.gnupg")
  (subpath "/private/tmp/lbx-golden/home/.docker")
  (subpath "/private/tmp/lbx-golden/home/.kube")
  (subpath "/private/tmp/lbx-golden/home/.netrc")
  (subpath "/private/tmp/lbx-golden/home/.git-credentials")
  (subpath "/private/tmp/lbx-golden/home/.npmrc")
  (subpath "/private/tmp/lbx-golden/home/.cargo/credentials.toml")
  (subpath "/private/tmp/lbx-golden/home/.config/gh")
  (subpath "/private/tmp/lbx-golden/home/.config/gcloud")
  (subpath "/private/tmp/lbx-golden/home/.config/containers")
  (subpath "/private/tmp/lbx-golden/home/.config/pip")
  (subpath "/private/tmp/lbx-golden/home/.pypirc")
  (subpath "/private/tmp/lbx-golden/home/.terraform.d")
  (subpath "/private/tmp/lbx-golden/home/.vault-token")
  (subpath "/private/tmp/lbx-golden/home/.password-store")
  (subpath "/private/tmp/lbx-golden/home/.local/share/keyrings")
  (subpath "/private/tmp/lbx-golden/home/Library/Keychains")
  (subpath "/private/tmp/lbx-golden/home/Library/Application Support/Google/Chrome")
  (subpath "/private/tmp/lbx-golden/home/Library/Application Support/Firefox")
  (subpath "/private/tmp/lbx-golden/home/Library/Safari")
  (subpath "/private/tmp/lbx-golden/home/Library/Cookies"))

(deny file-write*
  (subpath "/private/tmp/lbx-golden/home/.ssh")
  (subpath "/private/tmp/lbx-golden/home/.aws")
  (subpath "/private/tmp/lbx-golden/home/.gnupg")
  (subpath "/private/tmp/lbx-golden/home/.docker")
  (subpath "/private/tmp/lbx-golden/home/.kube")
  (subpath "/private/tmp/lbx-golden/home/.netrc")
  (subpath "/private/tmp/lbx-golden/home/.git-credentials")
  (subpath "/private/tmp/lbx-golden/home/.npmrc")
  (subpath "/private/tmp/lbx-golden/home/.cargo/credentials.toml")
  (subpath "/private/tmp/lbx-golden/home/.config/gh")
  (subpath "/private/tmp/lbx-golden/home/.config/gcloud")
  (subpath "/private/tmp/lbx-golden/home/.config/containers")
  (subpath "/private/tmp/lbx-golden/home/.config/pip")
  (subpath "/private/tmp/lbx-golden/home/.pypirc")
  (subpath "/private/tmp/lbx-golden/home/.terraform.d")
  (subpath "/private/tmp/lbx-golden/home/.vault-token")
  (subpath "/private/tmp/lbx-golden/home/.password-store")
  (subpath "/private/tmp/lbx-golden/home/.local/share/keyrings")
  (subpath "/private/tmp/lbx-golden/home/Library/Keychains")
  (subpath "/private/tmp/lbx-golden/home/Library/Application Support/Google/Chrome")
  (subpath "/private/tmp/lbx-golden/home/Library/Application Support/Firefox")
  (subpath "/private/tmp/lbx-golden/home/Library/Safari")
  (subpath "/private/tmp/lbx-golden/home/Library/Cookies"))

(deny file-write-unlink
  (subpath "/private/tmp/lbx-golden/home/.ssh")
  (subpath "/private/tmp/lbx-golden/home/.aws")
  (subpath "/private/tmp/lbx-golden/home/.gnupg")
  (subpath "/private/tmp/lbx-golden/home/.docker")
  (subpath "/private/tmp/lbx-golden/home/.kube")
  (subpath "/private/tmp/lbx-golden/home/.netrc")
  (subpath "/private/tmp/lbx-golden/home/.git-credentials")
  (subpath "/private/tmp/lbx-golden/home/.npmrc")
  (subpath "/private/tmp/lbx-golden/home/.cargo/credentials.toml")
  (subpath "/private/tmp/lbx-golden/home/.config/gh")
  (subpath "/private/tmp/lbx-golden/home/.config/gcloud")
  (subpath "/private/tmp/lbx-golden/home/.config/containers")
  (subpath "/private/tmp/lbx-golden/home/.config/pip")
  (subpath "/private/tmp/lbx-golden/home/.pypirc")
  (subpath "/private/tmp/lbx-golden/home/.terraform.d")
  (subpath "/private/tmp/lbx-golden/home/.vault-token")
  (subpath "/private/tmp/lbx-golden/home/.password-store")
  (subpath "/private/tmp/lbx-golden/home/.local/share/keyrings")
  (subpath "/private/tmp/lbx-golden/home/Library/Keychains")
  (subpath "/private/tmp/lbx-golden/home/Library/Application Support/Google/Chrome")
  (subpath "/private/tmp/lbx-golden/home/Library/Application Support/Firefox")
  (subpath "/private/tmp/lbx-golden/home/Library/Safari")
  (subpath "/private/tmp/lbx-golden/home/Library/Cookies"))
