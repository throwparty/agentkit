diff --git a/test/prototype-pollution.js b/test/prototype-pollution.js
new file mode 100644
index 0000000000000000000000000000000000000000..8531e9335f25812e364ffe80c26dd6c9c33637d9
--- /dev/null
+++ b/test/prototype-pollution.js
@@ -0,0 +1,56 @@
+// Regression tests for GHSA-gcqx-w48m-w2h4: mergeObject() wrote destination
+// keys with plain assignment, so an own `__proto__` key reached the inherited
+// accessor and replaced the prototype of the merged object.
+//
+// Runs on node:test so the package's dev dependencies are not required.
+
+const assert = require("node:assert/strict");
+const test = require("node:test");
+
+const deepmerge = require("../dist/cjs.js");
+
+const hostile = () => JSON.parse('{"__proto__": {"polluted": true}}');
+
+function assertUnpolluted(value) {
+	assert.equal(value.polluted, undefined, "merged value inherited a polluted property");
+	assert.equal(Object.getPrototypeOf(value), Object.prototype);
+}
+
+test("source prototype key does not reach the merged object", () => {
+	assertUnpolluted(deepmerge({}, hostile()));
+});
+
+test("source prototype key does not reach the merged object when the target has no prototype", () => {
+	// propertyIsUnsafe() only inspects the target: against a null-prototype
+	// target the key is not found up the chain, so it gets copied to the
+	// destination, where plain assignment would invoke the `__proto__` setter.
+	assertUnpolluted(deepmerge(Object.create(null), hostile()));
+});
+
+test("target prototype key is copied as data, not as a prototype", () => {
+	const merged = deepmerge(hostile(), {});
+
+	assertUnpolluted(merged);
+	assert.ok(Object.hasOwn(merged, "__proto__"), "own key should be copied");
+});
+
+test("deepmerge.all does not let an early value poison a later merge", () => {
+	assertUnpolluted(deepmerge.all([Object.create(null), hostile()]));
+});
+
+test("Object.prototype is left alone", () => {
+	deepmerge(Object.create(null), hostile());
+	deepmerge(hostile(), {});
+	deepmerge.all([Object.create(null), hostile()]);
+
+	assert.equal({}.polluted, undefined);
+});
+
+test("ordinary merging is unchanged", () => {
+	assert.deepEqual(deepmerge({ a: { b: 1 } }, { a: { c: 2 } }), {
+		a: { b: 1, c: 2 },
+	});
+	assert.deepEqual(deepmerge([1, 2], [3]), [1, 2, 3]);
+	assert.deepEqual(deepmerge.all([{ a: 1 }, { b: 2 }]), { a: 1, b: 2 });
+	assert.equal(deepmerge([], "replacement"), "replacement");
+});
