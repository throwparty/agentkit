prototypes[4]{name,dir,findings,proves}:
  isolation,adrs/2026-10-31-linux-bwrap-sandbox,adrs/2026-10-31-linux-bwrap-sandbox/findings.md,"bwrap builds the view from unprivileged user namespaces; a Rust build runs with no network and a read-only store; the hostile half of the workload is denied (T-003, T-004, T-016)"
  lifecycle,adrs/2026-10-31-linux-bwrap-lifecycle,adrs/2026-10-31-linux-bwrap-lifecycle/findings.md,"a systemd user scope gives freeze/thaw, MemoryMax and TasksMax; the no-systemd path falls back to process groups (T-009, T-010)"
  seatbelt,adrs/2026-10-31-darwin-app-sandbox,adrs/2026-10-31-darwin-app-sandbox/findings.md,"sandbox_init applies an SBPL profile to an unsigned binary; a devShell build runs with no baseline addition (T-001, T-002, T-017)"
  devshell-environment,adrs/2026-11-07-devshell-environment,adrs/2026-11-07-devshell-environment/findings.md,"a kind the contract does not name survives a real launcher; a backend needs contribution support, not kind support; the environment follows the nix-direnv rule (T-027 to T-032)"
plannedAdrs[8]{id,dir,dependsOn,owns,state}:
  A,sandbox-provider-contract,,"core trait, per-platform facet traits, two-level readiness, neutral handle, one factory, environment provenance, network endpoint type, CLI and MCP de-leaking",implemented
  G,sandbox-provisioning,A,"identity-named, typed setup steps; ordered per-backend provision lists on [backends.<name>]; project-declared compatibility with machine-owned backend settings; machine overrides; setup-command migration; doctor/preflight; CreateRequest.provision; FR-021 amendment",implemented
  B,devshell-environment,"A, G","prototype only: kind boundary and requirement reporting, host readiness and no-realisation preflight, differential environment from print-dev-env and the hook, closure as read-only mounts, no shell state in the sandbox; findings settle whether kinds live in the contract and what a backend reports",specified
  H,devshell-environment-implementation,B,"production implementation of the devshell kind and the contribution model in the shape the prototype settles: contributions on the request, persistence, doctor, consent, tests",implemented
  C,linux-bwrap-provider,"A, H","holder, setns join, cgroup assignment, pid-namespace fallback, golden argv, userns readiness, holder detachment; render environment and mounts; validate its own mount limit (the closure-size risk)",implemented
  D,darwin-sandbox-provider,"A, H","per-command helper, SBPL renderer, environment post-processing, golden profiles, sandbox_init readiness; render mounts; validate its own mount limit (the closure-size risk)",planned
  E,egress-proxy,A,"transport per platform, destination policy, configuration surface, port and socket allocation, lifecycle",planned
  F,automatic-backend-selection,A,"readiness-ordered choice, machine-owned preference, the user-freedom versus project-consistency trade-off",planned
steps[15]{track,n,step,state}:
  shared,1,"Define the provisioning abstraction (sandbox-provisioning): identity-named, typed steps, an ordered provision list on each backend, machine overrides, and the doctor/preflight report",done
  shared,2,"Decide automatic mechanism selection (automatic-backend-selection) once more than one backend is valid for a platform",pending
  shared,3,"Implement sandbox-provisioning: contract types, configuration and extraction, resolver, Docker command steps, doctor",done
  shared,4,"Prototype the devshell kind and settle the decisions the findings left open (T-027 to T-032)",done
  linux,1,"Capture the devShell environment on the host, with nix print-dev-env, and record which variables and which shell state do and do not survive (T-011)",done
  linux,2,"Build inside a holder with the captured environment and attribute every addition the build needs (T-016)",done
  linux,3,"Establish whether nix itself can run inside the sandbox, and what the daemon socket would grant if it did (T-018)",done
  linux,4,"Establish where the egress proxy must sit to be reachable from the holder's network namespace (T-014)",done
  linux,5,"Author the provider contract: core trait, per-platform facet traits, readiness, a neutral sandbox handle and one factory. Linux owns this because it has the first implementation; Darwin consumes it and amends it rather than forking it",done
  linux,6,"Implement the Linux provider in its own module: holder, setns join, cgroup assignment, pid-namespace fallback, closure bind with a whole-store option and golden argv",pending
  linux,7,"Reach Linux parity: proxy egress, snapshot integration, CLI and MCP behind the contract, documentation",pending
  darwin,1,"Build with a host-captured devShell environment inside the macOS sandbox and attribute every baseline addition the closure needs (T-017)",done
  darwin,2,"Establish where the egress proxy must sit given the profile's localhost-only host token (T-021)",done
  darwin,3,"Implement the Darwin provider in its own module against the contract: per-command helper, profile renderer, invariants, golden profiles, and a readiness check for the primitive",pending
  darwin,4,"Reach Darwin parity: profile baseline for a full devShell closure, Seatbelt egress, snapshot integration, documentation, and the sandbox_init longevity risk",pending
