{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "agentkit-lens-dev": {
      "command": ["cargo", "run", "--manifest-path", "Cargo.toml", "--bin", "agentkit-lens", "stdio"],
      "type": "local",
    },
    "agentkit-litterbox-dev": {
      "command": [
        "cargo",
        "run",
        "--manifest-path",
        "Cargo.toml",
        "--bin",
        "agentkit-litterbox",
        "stdio",
      ],
      "type": "local",
    },
  },
}
