(version 1)
(deny default (with message (param "p0")))
(allow process-exec)
(allow process-fork)
(allow process-info* (target same-sandbox))
(allow signal (target same-sandbox))
(allow file-read*
  (literal "/")
  (subpath (param "p1"))
  (subpath (param "p2"))
)
(allow file-read-metadata
  (literal (param "p1"))
  (literal (param "p3"))
  (literal (param "p4"))
  (literal (param "p5"))
  (literal (param "p6"))
  (literal (param "p2"))
)
(allow file-write*
  (literal "/dev/null")
  (subpath (param "p1"))
)
(allow sysctl-read)
(allow network-outbound
  (remote ip (param "p7"))
)
